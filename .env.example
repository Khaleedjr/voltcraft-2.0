# --- Payments (Paystack) -----------------------------------------------------
# Without these, checkout still works: the order is recorded and the customer is
# told the counter will call to arrange payment. Add the keys to take card, bank
# transfer and USSD payments online.
# Test keys start sk_test_ / pk_test_; live keys start sk_live_ / pk_live_.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Contact form ------------------------------------------------------------
# Any endpoint that accepts a JSON POST: a mail service, a Slack or Discord
# webhook, a CRM. Until this is set the contact form tells people to email or
# call instead of silently dropping the message.
CONTACT_WEBHOOK_URL=

# --- Database (Supabase) -----------------------------------------------------
# Products, stock, orders and customers live here, and the admin at /admin
# needs it. Run supabase/schema.sql once in the Supabase SQL editor (it is safe
# to run again after an update), then paste the project URL and the SERVICE
# ROLE key here (Dashboard → Settings → API).
#
# The service-role key bypasses row-level security. It is server-only: never
# give it a NEXT_PUBLIC_ prefix and never put it in client code. The anon key
# is not used — every table has RLS on with no policies, so the anon key can
# read nothing.
#
# Without these the shop still runs on the bundled catalogue, but checkout
# refuses to take payments rather than risk a paid order it cannot record.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (/admin) -------------------------------------------------------------
# Who can sign in. One entry per person, comma-separated, each made with:
#   node scripts/admin-password.mjs you@example.com
# which asks for the password and prints "you@example.com:s1.<salt>.<hash>".
# Only the hash is stored; changing someone's password signs them out everywhere.
ADMIN_ACCOUNTS=

# Signs the admin session cookie. 32+ random bytes; make one with:
#   node scripts/admin-password.mjs --secret
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=
